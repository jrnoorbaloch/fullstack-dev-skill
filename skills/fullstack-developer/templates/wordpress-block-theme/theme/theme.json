{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "720px", "wideSize": "1200px" },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base", "name": "Base", "color": "#ffffff" },
        { "slug": "surface", "name": "Surface", "color": "#f5f6fb" },
        { "slug": "contrast", "name": "Contrast", "color": "#141a33" },
        { "slug": "muted", "name": "Muted", "color": "#5d6890" },
        { "slug": "primary", "name": "Primary", "color": "#4f5bd5" },
        { "slug": "accent", "name": "Accent", "color": "#0ea5a4" },
        { "slug": "border", "name": "Border", "color": "#e1e5f5" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        { "slug": "body", "name": "Body", "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" },
        { "slug": "heading", "name": "Heading", "fontFamily": "'Plus Jakarta Sans', Inter, ui-sans-serif, system-ui, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
        { "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Extra Large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
        { "slug": "xx-large", "name": "Huge", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "4.25rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vh", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.5rem" },
        { "slug": "30", "name": "S", "size": "1rem" },
        { "slug": "40", "name": "M", "size": "1.5rem" },
        { "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
        { "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 6rem)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
    "typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.6" },
    "spacing": { "padding": { "left": "var:preset|spacing|40", "right": "var:preset|spacing|40" }, "blockGap": "var:preset|spacing|30" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.02em" } },
      "h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "link": { "color": { "text": "var:preset|color|primary" }, ":hover": { "typography": { "textDecoration": "none" } } },
      "button": {
        "color": { "background": "var:preset|color|primary", "text": "var:preset|color|base" },
        "border": { "radius": "10px" },
        "typography": { "fontWeight": "600" },
        "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem" } },
        ":hover": { "color": { "background": "var:preset|color|contrast" } },
        ":focus": { "outline": { "color": "var:preset|color|accent", "offset": "2px", "style": "solid", "width": "2px" } }
      }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "500" } },
      "core/site-title": { "typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "800", "fontSize": "var:preset|font-size|large" } },
      "core/post-title": { "elements": { "link": { "color": { "text": "var:preset|color|contrast" } } } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
